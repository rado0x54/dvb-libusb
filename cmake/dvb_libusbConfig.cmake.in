@PACKAGE_INIT@

# Re-resolve runtime/link deps that aren't part of the export set.
# libusb-1.0 is the only one — every other PUBLIC dep of dvb_libusb
# (dvb_handle, linuxdvbkpi) is exported as part of dvb_libusbTargets.
include(CMakeFindDependencyMacro)
find_dependency(PkgConfig)
pkg_check_modules(libusb REQUIRED IMPORTED_TARGET "libusb-1.0>=1.0.20")

include("${CMAKE_CURRENT_LIST_DIR}/dvb_libusbTargets.cmake")
